{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentEventSummary (P01 whitelist, Kotlin+Go shared)",
  "type": "object",
  "required": ["event_id","opaque_host_id","opaque_session_id","source","category","message","request_digest","revision","created_at","expires_at"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^event:.+"},
    "opaque_host_id": {"type": "string", "minLength": 1},
    "opaque_session_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["claude","codex","opencode","cursor","kimi","grok","pi","omp","hermes","gemini","antigravity","qwen"]},
    "category": {"enum": ["APPROVAL_REQUIRED","TASK_COMPLETE","SESSION_STARTED","SESSION_ENDED","TOOL_RUNNING","TOOL_FINISHED","ERROR"]},
    "title": {"type": "string"},
    "message": {"type": "string", "maxLength": 256},
    "truncated": {"type": "boolean"},
    "project_label": {"type": "string"},
    "model_label": {"type": "string"},
    "tool_label": {"type": "string"},
    "context_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "request_digest": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
