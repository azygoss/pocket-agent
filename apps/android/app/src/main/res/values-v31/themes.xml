<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: platform splash attr'ları (core-splashscreen bağımlılığı
         gerektirmez). ">" glifi term_bg üstünde gösterilir; splash kapanınca
         aktivite aynı tema ile devam eder (postSplashScreenTheme platformda
         yok — compat kütüphanesi attr'ıdır). -->
    <style name="Theme.PocketAgent.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/term_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/term_bg</item>
        <item name="android:statusBarColor">@color/term_bg</item>
        <item name="android:navigationBarColor">@color/term_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
